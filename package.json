  "scripts": {
    "dev": "vite --config dev/vite.config.ts",
    "dev:build": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "build:showcase": "vite build --config dev/vite.config.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "exports:generate": "node scripts/generate-exports.mjs",
    "exports:check": "node scripts/generate-exports.mjs --check",
    "verify": "npm run type-check && npm run lint && npm run format:check && npm run exports:check && npm run test && npm run build"
  },
